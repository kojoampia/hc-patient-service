/**
 * Health Connect — Patient subsystem entity model.
 *
 * This file is the model of record for the patient domain. Until now the model lived only as
 * `.jhipster/*.json` fragments, which had drifted apart between `hc-patient-service` (api) and
 * `hc-patient-dashboard` (web): `ClinicalCase` and `Recommendation` existed only on the backend,
 * `Stat` had lost `patientId` on the frontend, and several screens in the patient portal design
 * had no domain objects behind them at all.
 *
 * This file lives here because `api` owns the domain. The dashboard consumes the same model
 * through its own `.jhipster/*.json`, which is rendered from this file — regenerate both repos
 * together, never edit one side's entity JSON by hand.
 *
 * Import with:
 *   jhipster jdl patient.jdl
 *
 * Conventions kept from the existing entities, deliberately, so this stays a *extension* rather
 * than a rewrite:
 *   - ids are String (MongoDB ObjectId rendered as a string)
 *   - cross-entity references are held as plain String ids (`patientId`, `caseId`, …) rather than
 *     JHipster relationships. There are exactly two real relationships: ClinicalCase <-> Recommendation,
 *     because that one already existed on the backend, and Profile -> Address, added with care
 *     onboarding because a structured address cannot be recovered from a free-text one. Both are
 *     deliberate exceptions; a third should be argued for, not assumed.
 *   - audit columns are `createdDate` / `modifiedDate` / `createdBy` / `modifiedBy`
 *
 * Vitals are `Stat` — there is no separate Vital entity, by decision.
 */

// ===========================================================================
// Enumerations
// ===========================================================================

// TREATMENT is added by the portal refactor.
/** Lifecycle of a clinical case: raised, assessed, under treatment, then closed. */
enum CaseStatus {
  URGENT,
  OPEN,
  TREATMENT,
  CLOSED
}

/** Who took a reading. Distinct from ActivitySource because a reading can come from a DEVICE — a
 *  cuff or a meter reporting on its own — which is not something that can write a timeline entry.
 *  ANGEL was added with care-angel delegation, for the same reason it was added there. */
enum StatSource {
  PATIENT,
  PROFESSIONAL,
  ANGEL,
  DEVICE
}

/** Where a stat sits against its reference band, as judged when the reading was filed. */
enum StatFlag {
  OK,
  WARN,
  DANGER
}

/** Whether a prescription is still being taken. WITHHELD records a drug deliberately not given —
 *  the patient record has to be able to show "Amoxicillin — not given, penicillin allergy". */
enum MedicationStatus {
  ACTIVE,
  COMPLETED,
  WITHHELD
}

/** Appointment lifecycle, used by Task when it carries a scheduled visit. */
enum ScheduleStatus {
  CONFIRMED,
  PENDING,
  ATTENDED,
  CANCELLED
}

enum EmergencySeverity {
  LOW,
  MODERATE,
  HIGH
}

enum EmergencyStatus {
  RAISED,
  ACKNOWLEDGED,
  RESOLVED
}

/** Who put an entry on the activity timeline. */
// ANGEL was added with care-angel delegation: a care angel acting for a patient is neither the
// patient nor a clinician, and collapsing them into PATIENT would show a patient their angel's
// entry as if they had written it themselves. PROFESSIONAL keeps its name rather than becoming
// CLINICIAN — ActivityLog rows already carry it.
enum ActivitySource {
  PATIENT,
  PROFESSIONAL,
  ANGEL,
  SYSTEM
}

/** Where a patient is in the onboarding journey. There is deliberately no NOT_STARTED: that is the
 *  absence of a Profile, and a null value means COMPLETE so records written before onboarding
 *  existed are not dragged back through it. */
enum OnboardingStatus {
  IN_PROGRESS,
  COMPLETE
}

/** A care delegation's lifecycle. STANDBY is a dormant nomination the patient consented to in
 *  advance; it reaches PENDING only when two different professionals declare and countersign an
 *  incapacity, and ACTIVE only when the nominee themselves accepts. */
enum DelegationStatus {
  STANDBY,
  AWAITING_COUNTERSIGNATURE,
  PENDING,
  ACTIVE,
  DECLINED,
  REVOKED
}

/** Which side ended a delegation — the patient withdrawing access, or the angel stepping down. */
enum DelegationParty {
  PATIENT,
  ANGEL
}

/** What kind of event an activity entry describes — drives the timeline icon and colour. */
enum ActivityKind {
  CASE,
  VITAL,
  RECOMMENDATION,
  REPORT,
  VISIT,
  MEDICATION,
  NOTE
}

enum CarePlanType {
  DIET,
  EXERCISE
}

enum AllergyCategory {
  MEDICATION,
  FOOD,
  ENVIRONMENTAL,
  OTHER
}

enum AllergySeverity {
  MILD,
  MODERATE,
  SEVERE
}

// New. Deliberately not ScheduleStatus, which is the lifecycle of a patient appointment
// (confirmed/pending/attended/cancelled) and answers a different question about a different thing.
/** Where a shift sits relative to now: still to come, being worked, or over. */
enum ShiftStatus {
  ACTIVE,
  UPCOMING,
  COMPLETED
}

// ===========================================================================
// Existing entities — carried over, with additions marked
// ===========================================================================

// Added by the portal refactor: bloodGroup, careAngel*, about, socialHandle, imageUrl, patientId.
/** The patient's own details, as shown on the record header and the profile screen. */
entity Profile {
  id String
  patientId String
  firstName String
  middleNames String
  lastName String
  membership String
  birthDate LocalDate
  sex String
  bloodGroup String
  mobilePhone String
  phoneNumber String
  email String
  cardType String
  cardNumber String
  contacts String
  team String
  imageUrl String
  about String
  socialHandle String
  careAngelName String
  careAngelPhone String
  // The angel's identity. careAngelEmail is a denormalised pointer to the ACTIVE CareDelegation so
  // the profile screen can name the angel without a second query — it is NOT the source of truth and
  // must never be what an authorization check reads. CareDelegation is authoritative.
  careAngelEmail String
  careAngelLogin String
  onboardingStatus OnboardingStatus
  onboardingStep Integer
  onboardingCompletedAt Instant
}

entity Address {
  id String
  digitalAddress String
  streetAddress String
  areaCode String
  town String
  city String
  district String
  state String
  region String
  country String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

// Added by the portal refactor: patientId, memberNumber, plan, startDate, renewalDate.
/** The patient's subscription to a care plan, and the dates it runs between. */
entity Membership {
  id String
  patientId String
  name String
  description String
  status String
  memberNumber String
  plan String
  startDate LocalDate
  renewalDate LocalDate
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

// Added by the portal refactor: caseNumber, title, closedAt.
/**
 * A clinical episode: what the patient reported, what was found, and what was recommended.
 * caseNumber is the human-facing reference ("Case 12"); brief is the one-line summary shown
 * under the title.
 */
entity ClinicalCase {
  id String
  patientId String
  caseNumber Integer
  title String
  openedAt Instant
  closedAt Instant
  brief String
  status CaseStatus
  symptoms String
  diagnosis String
  assignedProfessionalId String
  assignedRosterId String
  // Archiving, the professional-only replacement for a delete that patient data does not allow.
  // archivedAt null means live; the other two are stamped from the caller and the request beside it.
  archivedAt Instant
  archivedById String
  archiveReason String
}

entity Recommendation {
  id String
  label String
  category String
}

// Added by the portal refactor: unit, secondaryValue, referenceLow, referenceHigh, flag, recordedAt.
// recordedAt exists because createdDate is a LocalDate and the trend charts need a time of day.
/**
 * A single recorded measurement — this is where vitals live. Blood pressure uses `value` for
 * the systolic reading and `secondaryValue` for the diastolic; every other vital uses `value`
 * alone. referenceLow/referenceHigh carry the normal band the reading is judged against.
 */
entity Stat {
  id String
  patientId String
  type String
  name String
  description String
  value Double
  secondaryValue Double
  unit String
  referenceLow Double
  referenceHigh Double
  flag StatFlag
  note String
  recordedAt Instant
  // Added by 67b103f to the domain class and the entity configs but never to this file, so the next
  // render would have deleted them. `source` is StatSource, not ActivitySource: a reading can come
  // from a device, which is not a thing that can put an entry on a timeline.
  recordedById String
  source StatSource
  createdDate LocalDate
  createdBy String
}

// Added by the portal refactor: caseId, dosage, status, startedOn, prescribedById.
// `prescription` is kept as-is for compatibility with records already written.
/**
 * A drug prescribed against a case. `dosage` is the instruction as the patient reads it
 * ("Twice daily with food"), which is what the medications screen shows.
 */
entity Medication {
  id String
  name String
  description String
  patientId String
  caseId String
  prescription String
  dosage String
  status MedicationStatus
  startedOn LocalDate
  prescribedById String
  // Who reported this. Set by the server from the authenticated caller, never from the payload —
  // a self-reported allergy and a clinician-attested one are clinically different facts.
  source ActivitySource
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

// Added by the portal refactor: summary, caseId, authorId, reportDate.
/**
 * A lab, imaging, clinical or immunisation report filed against a case. `summary` is the
 * plain-language reading shown to the patient; `description` stays free-form clinical text.
 */
entity Report {
  id String
  category String
  description String
  summary String
  name String
  url String
  patientId String
  caseId String
  authorId String
  reportDate LocalDate
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

entity Condition {
  id String
  name String
  description String
  patientId String
  // Who reported this. Set by the server from the authenticated caller, never from the payload —
  // a self-reported allergy and a clinician-attested one are clinically different facts.
  source ActivitySource
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

// Added by the portal refactor: scheduledAt, status, location, caseId.
// scheduledAt exists because `schedule` is a LocalDate and appointments need a time of day.
/** A planned appointment or piece of work — the counterpart to Visitation, which already happened. */
entity Task {
  id String
  name String
  description String
  schedule LocalDate
  scheduledAt Instant
  duration Double
  status ScheduleStatus
  location String
  caseId String
  attendantId String
  teamId String
  patientId String
  attendant String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

entity Team {
  id String
  name String
  description String
  contact String
}

entity Metadata {
  id String
  createdBy String
  modifiedBy String
  createdDate LocalDate
  modifiedDate LocalDate
  data String
}

entity PaymentOption {
  id String
  type String
  userID String
  metadata String
}

entity PersonalDocument {
  id String
  name String
  category String
  url String
  patientId String
  issuedOn LocalDate
  expiresOn LocalDate
}

// ===========================================================================
// New entities — the portal screens that had no domain object
// ===========================================================================

// New. Cases, visits, reports and medications all carry a professional id that nothing could resolve.
/** A member of the patient's care team — who they are, what they do and where they practise. */
entity Professional {
  id String
  firstName String
  lastName String
  role String
  specialty String
  email String
  phoneNumber String
  imageUrl String
  initials String
  location String
  teamId String
  // Added by 67b103f to the domain class and the entity configs but never to this file, so the next
  // render would have deleted it. How this person is addressed — "Dr.", "Prof.", "Sr." — and never
  // derived from the role.
  honorific String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

// New.
/** A visit that took place — the counterpart to Task, which is a visit that is planned. */
entity Visitation {
  id String
  patientId String
  caseId String
  professionalId String
  visitedAt Instant
  purpose String
  location String
  notes String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

entity Emergency {
  id String
  patientId String
  caseId String
  raisedAt Instant
  resolvedAt Instant
  brief String
  detail String
  severity EmergencySeverity
  status EmergencyStatus
  outcome String
  location String
  respondentId String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

// New.
/**
 * One entry on the record timeline. Entries are written by professionals, by the system when
 * something is filed, and by the patient themselves — hence `source` alongside `authorId`.
 */
entity ActivityLog {
  id String
  patientId String
  caseId String
  loggedAt Instant
  summary String
  detail String
  kind ActivityKind
  source ActivitySource
  authorId String
  createdDate LocalDate
  createdBy String
}

// New.
/** One line of a diet or exercise plan, with its own completion state so the patient can tick it off. */
entity CarePlanItem {
  id String
  patientId String
  planType CarePlanType
  label String
  detail String
  cadence String
  completed Boolean
  sortOrder Integer
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

// New. Allergies were being kept as Conditions, which cannot express severity or the reaction.
/** Something the patient reacts to, how badly, and what the reaction looked like. */
entity Allergy {
  id String
  patientId String
  name String
  category AllergyCategory
  severity AllergySeverity
  reaction String
  notedOn LocalDate
  notedById String
  // Who reported this. Set by the server from the authenticated caller, never from the payload —
  // a self-reported allergy and a clinician-attested one are clinically different facts.
  source ActivitySource
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

// New. `ClinicalCase.assignedRosterId` has pointed at nothing since the portal refactor named it —
// these two entities are what it points at.
//
// DutyRoster additionally carries `subscribedProfessionalIds`, a Mongo array of Professional ids,
// which is NOT declared below because JDL has no list-of-scalars type. It is maintained by hand in
// `domain/DutyRoster.java` and a regeneration of this entity will drop it — see the comment on the
// field. The alternative, a @DBRef many-to-many to Professional, was rejected on the grounds that it
// would be the second relationship in a domain that holds every other cross-entity reference as a
// bare String id.
//
// That argument no longer stands on its own: Profile -> Address is now a real relationship too (see
// the Relationships section). The rejection here still holds, but for the narrower reason that a
// roster's subscribers are a set of ids with no attributes of their own, where an address is a
// document with nine fields. Rarity was never the real objection; needing a document was.
/** A named rota a professional can be on duty for — a ward, a clinic, a night shift. */
entity DutyRoster {
  id String
  name String
  description String
  location String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

// New. Subscription to a roster and being rostered on it are different facts: a professional
// subscribed to a roster has no Shift until one is assigned, and a roster can exist with neither.
/** One professional's turn on a duty roster, between two instants. */
entity Shift {
  id String
  rosterId String
  professionalId String
  startsAt Instant
  endsAt Instant
  status ShiftStatus
  notes String
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

// New with care onboarding. This is the record that a care angel's access rests on, and the only
// thing PatientScope may consult when deciding whether one person may act for another —
// `Profile.careAngelEmail` is a display cache and reading it to authorize would be a bypass.
//
// Deliberately NOT given a generated CRUD resource: the lifecycle endpoints are the whole API. A
// generic PATCH would let an angel set their own status to ACTIVE, which is the entire security
// model in one careless verb.
/**
 * One person's authority to act for one patient.
 *
 * A patient nominates an angel (PENDING) who accepts (ACTIVE). Separately, a patient may name a
 * STANDBY nominee and consent in advance that clinicians may activate them — which takes two
 * different professionals, and still ends in the nominee accepting. Nothing here is ever deleted;
 * ending a delegation records who ended it and when.
 */
entity CareDelegation {
  id String
  patientId String
  angelEmail String
  angelLogin String
  angelName String
  angelPhone String
  status DelegationStatus
  grantedAt Instant
  acceptedAt Instant
  revokedAt Instant
  revokedBy DelegationParty
  // The standby path. advanceConsent is the patient's recorded authorisation and the only evidence
  // they ever agreed; without it on the row, activation must be refused. The two professional ids
  // must differ — that single check is the whole of the two-signature control.
  advanceConsent Boolean
  activationRequestedById String
  activationRequestedAt Instant
  activationReason String
  countersignedById String
  countersignedAt Instant
  createdDate LocalDate
  modifiedDate LocalDate
  createdBy String
  modifiedBy String
}

// ===========================================================================
// Relationships
// ===========================================================================

relationship ManyToMany {
  ClinicalCase{recommendation} to Recommendation{clinicalCase}
}

// Profile.address was a plain String until care onboarding needed a real one — a digital address,
// a town and a region cannot be recovered from "5 Ankobra River Street". This is the second real
// relationship in the domain, and the comment on DutyRoster above explains why that count used to
// be one. Address already carries `patientId` and AddressResource already scopes on it, so the
// referenced document is protected by the same rules as everything else the patient owns.
relationship OneToOne {
  Profile{address} to Address
}

// ===========================================================================
// Options
// ===========================================================================

service ClinicalCase, Recommendation, Profile, Professional, Visitation, Emergency, ActivityLog, CarePlanItem, Allergy, CareDelegation with serviceClass

paginate Profile, Report, Medication, Visitation, ActivityLog, Task with pagination
paginate ClinicalCase with infinite-scroll

microservice * with hcPatientService
clientRootFolder * with patientMS
